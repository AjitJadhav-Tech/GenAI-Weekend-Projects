				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "1. Check Apple Stock (AAPL)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"prompt\": \"What is the current stock price of Apple (AAPL)?\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://bedrock-agentcore.{{AWS_REGION}}.amazonaws.com/runtimes/{{AGENT_ARN_ENCODED}}/invocations",
					"protocol": "https",
					"host": [
						"bedrock-agentcore",
						"{{AWS_REGION}}",
						"amazonaws",
						"com"
					],
					"path": [
						"runtimes",
						"{{AGENT_ARN_ENCODED}}",
						"invocations"
					]
				},
				"description": "Invoke live agent endpoint to fetch Apple (AAPL) stock price using yfinance tool."
			},
			"response": []
		},

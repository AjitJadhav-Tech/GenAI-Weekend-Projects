		"_postman_id": "bedrock-agentcore-runtime-collection",
		"name": "Amazon Bedrock AgentCore Runtime API",
		"description": "Postman Collection to invoke the deployed Bedrock AgentCore Runtime Stock Agent endpoint directly over HTTPS using AWS Signature (SigV4).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
